# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://ucaas:change-me@localhost:5432/ucaas
REDIS_URL=redis://localhost:6379
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-too
SESSION_SECRET=generate-a-long-random-string
MASTER_ENCRYPTION_KEY=base64-32-byte-key
SEARCH_PROVIDER=none        # none | brave   (brave also needs SEARCH_API_KEY)
SEARCH_API_KEY=
LLM_PROVIDER=none           # none | anthropic | openai (form mapping and AI discovery support openai)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini         # optional; used for form mapping and US discovery when LLM_PROVIDER=openai
PORT=3000
SITE_CAPACITY=2500           # how many active sites the directory keeps full
COOKIE_SECURE=false          # set to true when served over HTTPS
WORKER_CONCURRENCY=3
PER_DOMAIN_RATE_LIMIT_PER_MIN=6
